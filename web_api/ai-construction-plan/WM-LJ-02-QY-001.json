  "knowledge": {
    "foreword": "针对海陆交汇区域沙性地质，尤其在地下水位高、流沙严重区域的施工总结形成的工法，有效解决注浆过程中水泥浆被地下水、流沙带走无法固结的问题。",
    "features": [
      {
        "feature_id": "F01",
        "content": "通过土体挤密构成浆脉复合地基，提高软土地基承载力",
        "dimension": "技术效果"
      },
      {
        "feature_id": "F02",
        "content": "噪音小、无震动、维护效果好",
        "dimension": "环保性能"
      },
      {
        "feature_id": "F03",
        "content": "施工工艺简单，便于操作，施工质量高，适用性强",
        "dimension": "施工便利性"
      }
    ],
    "applicability": {
      "suitable_conditions": [
        "中砂海陆交汇区域沙性地质",
        "地下水位高、流沙严重区域",
        "黏土地基（有适宜排水条件时）"
      ],
      "unsuitable_conditions": [],
      "geological_keywords": [
        "沙性地质",
        "高水位",
        "流沙",
        "中砂",
        "海陆交汇"
      ],
      "structural_keywords": [
        "路基",
        "地基加固",
        "基础处理"
      ]
    },
    "principle": {
      "core_mechanism": "压密注浆将水泥浆混合速凝剂注入地层设计深度，浆液以填充、渗透、挤密方式赶走土颗粒间水分和空气，经人工控制时间胶结成U型结石体。",
      "key_innovation": "添加速凝剂解决高水位流沙区浆液被带走问题，形成浆土结合体实现综合加固"
    },
    "process_flow": {
      "description": "施工准备→测量放线→原材料检验→钻机就位→水泥浆拌制→打孔至设计标高→注浆(提升注浆)→注浆结束",
      "steps": [
        {
          "step_id": "S01",
          "name": "施工准备",
          "description": "清除表层耕植土、回填沙至设计标高、开挖沟槽与集水坑、准备机械器具仪表管路材料水电"
        },
        {
          "step_id": "S02",
          "name": "测量放线",
          "description": "利用全站仪进行桩位定位放样，允许偏差2cm"
        },
        {
          "step_id": "S03",
          "name": "原材料检验",
          "description": "水泥按JTGF801-2012检测，外加剂按GB8076-2008检测"
        },
        {
          "step_id": "S04",
          "name": "钻机就位",
          "description": "根据放线点位安装调试钻机，通过试验段确定浆比重、注浆流量、提升速度"
        },
        {
          "step_id": "S05",
          "name": "水泥浆拌制",
          "description": "每100m设制浆点，投料顺序水→水泥→粉煤灰→水玻璃，搅拌≥3min"
        },
        {
          "step_id": "S06",
          "name": "打孔",
          "description": "Φ25mm钻头注浆管压入土中至设计深度，垂直偏差≤1%"
        },
        {
          "step_id": "S07",
          "name": "注浆",
          "description": "自下而上，压力0.5-1.0MPa，流速0-1.0L/min，跳孔注浆梅花形布置"
        },
        {
          "step_id": "S08",
          "name": "注浆结束",
          "description": "提升至设计标高，提出注浆管，清洗管路"
        }
      ]
    }
  },
