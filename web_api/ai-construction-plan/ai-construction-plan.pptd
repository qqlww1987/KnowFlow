title: "AI驱动实施性施工组织设计生成方案"
size: [1280, 720]
theme:
  colors:
    primary: "#2C3539"
    secondary: "#8B8C7A"
    accent: "#C8963E"
    background: "#F5F4F0"
    text: "#3D4145"
    darkBg: "#1E2426"
    cardBg: "#EEEDEA"
  textStyles:
    coverTitle:
      fontSize: 44
      color: "#FFFFFF"
      fontFamily: "Liter, MiSans"
      lineHeight: 1.2
      letterSpacing: 2
    chapterNum:
      fontSize: 120
      color: "$accent"
      fontFamily: "Liter, MiSans"
      lineHeight: 1.0
    title:
      fontSize: 28
      color: "$primary"
      fontFamily: "Liter, MiSans"
      lineHeight: 1.3
    subtitle:
      fontSize: 18
      color: "$secondary"
      fontFamily: "Liter, MiSans"
      lineHeight: 1.5
    body:
      fontSize: 18
      color: "$text"
      fontFamily: "Liter, MiSans"
      lineHeight: 1.6
    bigNumber:
      fontSize: 56
      color: "$accent"
      fontFamily: "Liter, MiSans"
      lineHeight: 1.1
    label:
      fontSize: 13
      color: "$secondary"
      fontFamily: "Liter, MiSans"
      lineHeight: 1.4
  tableStyles:
    default:
      fontSize: 14
      fontFamily: "Liter, MiSans"
      headerFill: "$primary"
      headerColor: "#FFFFFF"
      headerBold: true
      bodyFill: ["#FFFFFF", "$cardBg"]
      bodyColor: "$text"
      border:
        style: solid
        width: 1
        color: "#D1CFCA"
pages:
  - pages/p01_cover.page
  - pages/p02_toc.page
  - pages/p03_ch1.page
  - pages/p04_structure.page
  - pages/p05_data_density.page
  - pages/p06_ch2.page
  - pages/p07_design_files.page
  - pages/p08_contract_files.page
  - pages/p09_site_files.page
  - pages/p10_ch3.page
  - pages/p11_kb_arch.page
  - pages/p12_kb_engineering.page
  - pages/p13_kb_organization.page
  - pages/p14_kb_standardization.page
  - pages/p15_ch4.page
  - pages/p16_system_arch.page
  - pages/p17_generation_flow.page
  - pages/p18_roadmap.page
  - pages/p19_final.page