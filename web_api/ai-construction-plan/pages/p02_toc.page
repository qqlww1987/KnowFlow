pageType: table_of_contents
background:
  type: solid
  color: "$background"
elements:
  - elementId: left-image
    elementType: image
    bounds: [0, 0, 420, 720]
    src: "/mnt/agents/output/ai-construction-plan/images/interchange.png"
    fit: {mode: cover}
  - elementId: left-mask
    elementType: shape
    bounds: [0, 0, 420, 720]
    shapeName: rect
    fill:
      type: gradient
      gradientType: linear
      angle: 0
      stops:
        - {position: 0, color: "#1E242600"}
        - {position: 0.7, color: "#1E242640"}
        - {position: 1, color: "#1E2426E6"}
  - elementId: contents-label
    elementType: text
    bounds: [480, 60, 300, 40]
    content:
      fontSize: 14
      color: "$accent"
      fontFamily: "Liter, MiSans"
      letterSpacing: 4
      wrap: false
      text: |
        <p><strong>CONTENTS</strong></p>
  - elementId: toc-title
    elementType: text
    bounds: [480, 100, 400, 44]
    content:
      style: "$title"
      fontSize: 32
      wrap: false
      text: |
        <p><strong>方案总览</strong></p>
  - elementId: divider-top
    elementType: shape
    bounds: [480, 160, 700, 1]
    shapeName: rect
    fill:
      type: solid
      color: "#D1CFCA"
  - elementId: num-01
    elementType: text
    bounds: [480, 190, 70, 56]
    content:
      fontSize: 40
      color: "$accent"
      fontFamily: "Liter, MiSans"
      wrap: false
      align: [left, top]
      text: |
        <p><strong>01</strong></p>
