pageType: chapter
background:
  type: image
  src: "/mnt/agents/output/ai-construction-plan/images/ai_network.png"
  fit: {mode: cover}
  mask:
    type: solid
    color: "#1E2426D9"
elements:
  - elementId: big-number
    elementType: text
    bounds: [60, 180, 300, 160]
    content:
      fontSize: 160
      color: "#C8963E20"
      fontFamily: "Liter, MiSans"
      wrap: false
      text: |
        <p><strong>04</strong></p>
  - elementId: accent-line
    elementType: shape
    bounds: [380, 260, 60, 3]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"
  - elementId: chapter-title
    elementType: text
    bounds: [380, 280, 700, 56]
    content:
      fontSize: 36
      color: "#FFFFFF"
      fontFamily: "Liter, MiSans"
      wrap: false
      text: |
        <p><strong>AI生成技术实施方案</strong></p>
  - elementId: chapter-subtitle
    elementType: text
    bounds: [380, 350, 700, 30]
    content:
      fontSize: 18
      color: "#FFFFFF80"
      fontFamily: "Liter, MiSans"
      wrap: false
      text: |
        <p>从系统架构到关键技术的完整技术路线</p>
  - elementId: bottom-line
    elementType: shape
    bounds: [60, 650, 1160, 1]
    shapeName: rect
    fill:
      type: solid
      color: "#FFFFFF15"