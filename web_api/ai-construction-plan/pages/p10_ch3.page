pageType: chapter
background:
  type: solid
  color: "$darkBg"
elements:
  - elementId: bg-pattern
    elementType: image
    bounds: [680, 0, 600, 720]
    src: "/mnt/agents/output/ai-construction-plan/images/ai_network.png"
    fit: {mode: cover}
    opacity: 0.2
  - elementId: big-number
    elementType: text
    bounds: [60, 180, 300, 160]
    content:
      fontSize: 160
      color: "#C8963E20"
      fontFamily: "Liter, MiSans"
      wrap: false
      text: |
        <p><strong>03</strong></p>
  - elementId: accent-line
    elementType: shape
    bounds: [380, 260, 60, 3]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"
  - elementId: chapter-title
    elementType: text
    bounds: [380, 280, 700, 56]
    content:
      fontSize: 36
      color: "#FFFFFF"
      fontFamily: "Liter, MiSans"
      wrap: false
      text: |
        <p><strong>专业知识库构建方案</strong></p>
  - elementId: chapter-subtitle
    elementType: text
    bounds: [380, 350, 700, 30]
    content:
      fontSize: 18
      color: "#FFFFFF80"
      fontFamily: "Liter, MiSans"
      wrap: false
      text: |
        <p>构建面向施工组织设计生成的多维专业知识库体系</p>
  - elementId: bottom-line
    elementType: shape
    bounds: [60, 650, 1160, 1]
    shapeName: rect
    fill:
      type: solid
      color: "#FFFFFF15"