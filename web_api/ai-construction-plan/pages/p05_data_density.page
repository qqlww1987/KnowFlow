pageType: content
background:
  type: solid
  color: "$background"
elements:
  - elementId: page-title
    elementType: text
    bounds: [60, 40, 1000, 40]
    content:
      style: "$title"
      wrap: false
      text: |
        <p><strong>核心数据密度分析：工程量 × 工艺 × 资源 × 进度</strong></p>
  - elementId: title-accent
    elementType: shape
    bounds: [60, 85, 40, 3]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"
  - elementId: kpi-card-1
    elementType: shape
    bounds: [60, 110, 270, 180]
    shapeName: rect
    fill:
      type: solid
      color: "$cardBg"
  - elementId: kpi-num-1
    elementType: text
    bounds: [80, 125, 250, 70]
    content:
      style: "$bigNumber"
      wrap: false
      text: |
        <p><strong>302.7</strong><span style="font-size:24px;">万m³</span></p>
  - elementId: kpi-label-1
    elementType: text
    bounds: [80, 200, 230, 24]
    content:
      fontSize: 16
      color: "$primary"
      fontFamily: "Liter, MiSans"
      wrap: false
      text: |
        <p><strong>路基挖方总量</strong></p>
  - elementId: kpi-desc-1
    elementType: text
    bounds: [80, 228, 230, 56]
    content:
      fontSize: 13
      color: "$secondary"
      fontFamily: "Liter, MiSans"
      lineHeight: 1.4
      text: |
        <p>填方231.2万m³</p>
        <p>挖填不平衡，需外弃166万m³</p>
  - elementId: kpi-card-2
    elementType: shape
    bounds: [350, 110, 270, 180]
    shapeName: rect
    fill:
      type: solid
      color: "$cardBg"
  - elementId: kpi-num-2
    elementType: text
    bounds: [370, 125, 230, 70]
    content:
      style: "$bigNumber"
      wrap: false
      text: |
        <p><strong>5</strong><span style="font-size:24px;">座</span></p>
  - elementId: kpi-label-2
    elementType: text
    bounds: [370, 200, 230, 24]
    content:
      fontSize: 16
      color: "$primary"
      fontFamily: "Liter, MiSans"
      wrap: false
      text: |
        <p><strong>主线桥梁</strong></p>
  - elementId: kpi-desc-2
    elementType: text
    bounds: [370, 228, 230, 56]
    content:
      fontSize: 13
      color: "$secondary"
      fontFamily: "Liter, MiSans"
      lineHeight: 1.4
      text: |
        <p>特大桥1座+大桥4座</p>
        <p>总长4141.5m，占比62.75%</p>
  - elementId: kpi-card-3
    elementType: shape
    bounds: [640, 110, 270, 180]
    shapeName: rect
    fill:
      type: solid
      color: "$cardBg"
  - elementId: kpi-num-3
    elementType: text
    bounds: [660, 125, 230, 70]
    content:
      style: "$bigNumber"
      wrap: false
      text: |
        <p><strong>1891</strong><span style="font-size:24px;">片</span></p>
  - elementId: kpi-label-3
    elementType: text
    bounds: [660, 200, 230, 24]
    content:
      fontSize: 16
      color: "$primary"
      fontFamily: "Liter, MiSans"
      wrap: false
      text: |
        <p><strong>T梁预制总量</strong></p>
  - elementId: kpi-desc-3
    elementType: text
    bounds: [660, 228, 230, 56]
    content:
      fontSize: 13
      color: "$secondary"
      fontFamily: "Liter, MiSans"
      lineHeight: 1.4
      text: |
        <p>3座梁场协同生产</p>
        <p>30m/40m两种规格</p>
  - elementId: kpi-card-4
    elementType: shape
    bounds: [930, 110, 290, 180]
    shapeName: rect
    fill:
      type: solid
      color: "$cardBg"
  - elementId: kpi-num-4
    elementType: text
    bounds: [950, 125, 250, 70]
    content:
      style: "$bigNumber"
      wrap: false
      text: |
        <p><strong>44</strong><span style="font-size:24px;">人</span></p>
  - elementId: kpi-label-4
    elementType: text
    bounds: [950, 200, 250, 24]
    content:
      fontSize: 16
      color: "$primary"
      fontFamily: "Liter, MiSans"
      wrap: false
      text: |
        <p><strong>管理团队编制</strong></p>
  - elementId: kpi-desc-4
    elementType: text
    bounds: [950, 228, 250, 56]
    content:
      fontSize: 13
      color: "$secondary"
      fontFamily: "Liter, MiSans"
      lineHeight: 1.4
      text: |
        <p>7个职能部门+3个工区</p>
        <p>含工地试验室9人</p>
  - elementId: detail-table
    elementType: table
    bounds: [60, 320, 1160, 310]
    columnWidths: [0.22, 0.20, 0.20, 0.20, 0.18]
    rowHeights: [0.14, 0.143, 0.143, 0.143, 0.143, 0.143, 0.145]
    style: "$default"
    rows:
      - - content: {text: "<p><strong>工程类别</strong></p>"}
        - content: {text: "<p><strong>工程量</strong></p>"}
        - content: {text: "<p><strong>施工方法</strong></p>"}
        - content: {text: "<p><strong>主要设备</strong></p>"}
        - content: {text: "<p><strong>工期节点</strong></p>"}
      - - content: {text: "<p>路基土石方</p>"}
        - content: {text: "<p>挖302.7万m³</p>"}
        - content: {text: "<p>机械开挖+爆破</p>"}
        - content: {text: "<p>挖机/压路机/推土机</p>"}
        - content: {text: "<p>2026.1-2026.12</p>"}
      - - content: {text: "<p>桩基工程</p>"}
        - content: {text: "<p>冲击钻+旋挖钻+人工</p>"}
        - content: {text: "<p>三种成孔方式</p>"}
        - content: {text: "<p>冲击钻69台</p>"}
        - content: {text: "<p>按桥分批</p>"}
      - - content: {text: "<p>桥梁下部结构</p>"}
        - content: {text: "<p>圆柱墩+方墩</p>"}
        - content: {text: "<p>翻模法施工</p>"}
        - content: {text: "<p>汽车吊25台+塔吊8台</p>"}
        - content: {text: "<p>2026.11-2027.9</p>"}
      - - content: {text: "<p>T梁预制架设</p>"}
        - content: {text: "<p>1891片T梁</p>"}
        - content: {text: "<p>预制场集中预制</p>"}
        - content: {text: "<p>架桥机3台+龙门吊</p>"}
        - content: {text: "<p>3个梁场协同</p>"}
      - - content: {text: "<p>边坡防护</p>"}
        - content: {text: "<p>锚索/锚杆框架梁</p>"}
        - content: {text: "<p>人工+机械配合</p>"}
        - content: {text: "<p>潜孔钻/注浆设备</p>"}
        - content: {text: "<p>随路基同步</p>"}
      - - content: {text: "<p>临时设施</p>"}
        - content: {text: "<p>25处变压器</p>"}
        - content: {text: "<p>沿线布设</p>"}
        - content: {text: "<p>630KVA/400KVA等</p>"}
        - content: {text: "<p>开工前完成</p>"}
  - elementId: bottom-line
    elementType: shape
    bounds: [60, 660, 1160, 2]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"
  - elementId: page-num
    elementType: text
    bounds: [1190, 680, 50, 24]
    content:
      fontSize: 13
      color: "$secondary"
      fontFamily: "Liter, MiSans"
      wrap: false
      align: [right, middle]
      text: |
        <p>05</p>