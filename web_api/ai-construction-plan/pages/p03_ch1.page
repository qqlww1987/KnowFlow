pageType: chapter
background:
  type: image
  src: "/mnt/agents/output/ai-construction-plan/images/cover_bridge.png"
  fit: {mode: cover}
  mask:
    type: solid
    color: "#1E2426D9"
elements:
  - elementId: big-number
    elementType: text
    bounds: [60, 180, 300, 160]
    content:
      style: "$chapterNum"
      fontSize: 160
      color: "#C8963E20"
      wrap: false
      text: |
        <p><strong>01</strong></p>
  - elementId: accent-line
    elementType: shape
    bounds: [380, 260, 60, 3]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"
  - elementId: chapter-title
    elementType: text
    bounds: [380, 280, 700, 56]
    content:
      fontSize: 36
      color: "#FFFFFF"
      fontFamily: "Liter, MiSans"
      wrap: false
      text: |
        <p><strong>施工组织设计文档深度解析</strong></p>
  - elementId: chapter-subtitle
    elementType: text
    bounds: [380, 350, 700, 30]
    content:
      fontSize: 18
      color: "#FFFFFF99"
      fontFamily: "Liter, MiSans"
      wrap: false
      text: |
        <p>以G6002贵阳环高扩容项目T9合同段为例，拆解文档结构与数据依赖</p>
  - elementId: bottom-line
    elementType: shape
    bounds: [60, 650, 1160, 1]
    shapeName: rect
    fill:
      type: solid
      color: "#FFFFFF20"